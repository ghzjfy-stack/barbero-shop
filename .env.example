# Vercel → Project Settings → Environment Variables (Production + Preview).
# Do NOT commit real secrets. Never use VITE_* for these (they would leak to the browser).

# From @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Orders group chat id (groups are usually negative, e.g. -1001234567890).
# Add the bot to the group, send a message, then open:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# and copy result.message.chat.id
TELEGRAM_CHAT_ID=-1001234567890

# Optional: forum topic id inside a Topics-enabled group
# TELEGRAM_MESSAGE_THREAD_ID=123

# Telegram webhook secret for orders menu + status buttons.
# Random long string — same value in setWebhook secret_token.
# After deploy, once:
#   curl -X POST "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
#     -d "url=https://www.barbero.co.il/api/telegram-webhook" \
#     -d "secret_token=$TELEGRAM_WEBHOOK_SECRET" \
#     -d 'allowed_updates=["callback_query","message"]'
#   curl "https://www.barbero.co.il/api/telegram-webhook?setup=1"
# TELEGRAM_WEBHOOK_SECRET=choose-a-long-random-string

# Supabase (project "barbero") — Settings → API
# URL + service_role key (server only; used by /api/customers + /api/orders)
# After setting env: open Supabase → SQL Editor → run supabase/schema.sql once
# (creates public.orders + repairs public.customers), then Redeploy on Vercel.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role...

# Google Sheets — Apps Script Web App that appends order + newsletter rows
# and serves order tracking (type:"track"). See google-apps-script/barbero-orders.gs
# Creates tabs: הזמנות + ניוזלטר — paste + Deploy → New version after script changes
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
# Optional shared secret (must match WEBHOOK_SECRET inside the Apps Script)
# GOOGLE_SHEETS_WEBHOOK_SECRET=choose-a-long-random-string

# Resend — order confirmation emails (server only; /api/send-email)
# Create a key at https://resend.com/api-keys — never commit the real value.
RESEND_API_KEY=re_xxxxxxxx
# Default recipient for test sends (body.to overrides)
RESEND_TO_EMAIL=you@example.com
# Verified sender. Until your domain is verified, use Resend's onboarding address:
# RESEND_FROM=BARBERO <onboarding@resend.dev>
# After domain verify: RESEND_FROM=BARBERO <orders@yourdomain.com>

# Absolute site origin used in the email "להשלמת התשלום" button (/pay link).
# Optional on Vercel — falls back to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL.
# PUBLIC_SITE_URL=https://barbero-ten.vercel.app
# Optional dedicated secret for signed /pay links (defaults to RESEND_API_KEY).
# PAY_LINK_SECRET=choose-a-long-random-string

# --- Analytics (client-safe) ---
# Vercel Web Analytics + Speed Insights: no env needed. After deploy, enable in
# Vercel → Project → Analytics → Enable Web Analytics (and Speed Insights).
# Google Analytics 4 Measurement ID (public, looks like G-XXXXXXXXXX).
# Create at https://analytics.google.com → Admin → Data streams → Web.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta (Facebook) Pixel ID — digits only, public in the browser.
# Events Manager → Data sources → Pixels → your pixel → Pixel ID
# Browser: PageView, ViewContent, AddToCart, InitiateCheckout, AddPaymentInfo
# Purchase fires after real payment (customer «אישרתי ששילמתי» or Telegram «שולם» via CAPI)
VITE_META_PIXEL_ID=1131099525966263
# Server Conversions API (optional but recommended for ad optimization on real sales)
# META_PIXEL_ID=1131099525966263
# META_CAPI_ACCESS_TOKEN=EAAB...  (Events Manager → Settings → Generate access token)
